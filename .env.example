# Sao chép thành .env.local và điền giá trị thật.
# Cả hai đều là giá trị CÔNG KHAI (xuất hiện trong HTML). Không đặt khóa bí mật vào biến NEXT_PUBLIC_*.

# [CẦN CUNG CẤP] URL trang mua hàng / thanh toán (bắt buộc https://)
NEXT_PUBLIC_BUY_URL=

# [CẦN CUNG CẤP] Domain chính thức, dùng cho canonical, Open Graph, sitemap
NEXT_PUBLIC_SITE_URL=https://example.com
