# Sao chép thành .env.local và điền giá trị thật.

# --- Công khai (xuất hiện trong HTML/JS). Không đặt khoá bí mật vào biến NEXT_PUBLIC_*. ---
# [CẦN CUNG CẤP] Domain chính thức, dùng cho canonical, Open Graph, sitemap
NEXT_PUBLIC_SITE_URL=https://example.com
# [CẦN CUNG CẤP] Link file PDF catalogue (bắt buộc https://). Trống → nút "Tải catalogue" hiển thị trạng thái cần cung cấp.
NEXT_PUBLIC_CATALOGUE_URL=

# --- Chỉ phía server (KHÔNG có tiền tố NEXT_PUBLIC → không lộ ra trình duyệt). ---
# [CẦN CUNG CẤP] Webhook nhận form đặt lịch nghe thử (CRM/Google Sheet/Zapier...). Trống → API trả 503 rõ ràng.
BOOKING_WEBHOOK_URL=
